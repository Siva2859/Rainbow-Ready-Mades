# ==============================================================================
# Rainbow Ready Mades - Environment Variables Template
# Copy this file to .env and fill in the values for local development.
# WARNING: NEVER commit the actual .env file with real secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL / ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=True
PROJECT_NAME="Rainbow Ready Mades"

# ------------------------------------------------------------------------------
# 2. BACKEND API (FastAPI) & DATABASE (Developer 2)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database URL
# For local SQLite prototyping during early MVP dev:
# DATABASE_URL=sqlite:///./rainbow_readymades.db
# For PostgreSQL (target architecture):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rainbow_readymades

# JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Initial Credentials (for database seed)
ADMIN_INITIAL_EMAIL=admin@rainbowreadymades.local
ADMIN_INITIAL_PASSWORD=ChangeThisSecurePassword123!

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. RAG & AI CHATBOT SERVICE (Developer 3)
# ------------------------------------------------------------------------------
# Provider: Google Gemini / OpenAI / Anthropic / Local
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Model (Target: text-embedding-004 or all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=models/text-embedding-004

# Vector Database Configuration
VECTOR_DB_TYPE=chroma
VECTOR_DB_DIRECTORY=./rag-chatbot/data/chroma_db
SIMILARITY_SCORE_THRESHOLD=0.65
TOP_K_RETRIEVAL=4

# Chatbot Microservice Port (if deployed as independent service)
CHATBOT_PORT=8001

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Developer 1)
# ------------------------------------------------------------------------------
# Base URLs for API calls from the browser UI
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CHATBOT_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Rainbow Ready Mades"
