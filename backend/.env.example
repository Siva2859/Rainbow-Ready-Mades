# ==============================================================================
# Rainbow Ready Mades - Backend Environment Configuration
# Copy this file to .env inside the backend/ directory or root directory.
# NEVER commit the actual .env file with production credentials!
# ==============================================================================

# Project & App Settings
PROJECT_NAME="Rainbow Ready Mades Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For local prototyping or if Supabase is not yet configured, SQLite can be used:
# DATABASE_URL="sqlite:///./rainbow_readymades.db"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rainbow_readymades"

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# Generate a secret via: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY="super_secret_jwt_key_change_in_production_min_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Seed Credentials
ADMIN_INITIAL_EMAIL="admin@rainbowreadymades.local"
ADMIN_INITIAL_PASSWORD="ChangeThisAdminPassword123!"

# CORS Allowed Origins (Comma-separated URLs for React frontend)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
